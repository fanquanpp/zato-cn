# game/ep2d6.rpy:55
translate chinese ep2d6_caeec17f:

    # nvl clear
    # n "And it’s a beautiful song."
    nvl clear
    n "而这是一首美丽的歌。{size=-8}{color=#999999} And it’s a beautiful song.{/color}{/size}"

