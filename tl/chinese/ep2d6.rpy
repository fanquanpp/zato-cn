translate chinese ep2d6_398b103e:

    # extend " The line needs to be longer."
    extend " 把线画得更长就行了。{size=-8}{color=#999999} The line needs to be longer.{/color}{/size}"

# game/ep2d6.rpy:29
translate chinese ep2d6_a7b74863:

    # extend "\n\nAnd past a certain point, all deviations – even ones spanning thousands of light years – will become negligible."
    extend "\n\n而过了某个临界点，一切偏差——哪怕绵延数千光年——都会变得微不足道。{size=-8}{color=#999999} \n\nAnd past a certain point, all deviations – even ones spanning thousands of light years – will become negligible.{/color}{/size}"

# game/ep2d6.rpy:30
translate chinese ep2d6_353e3242:

    # extend "\n\n\n\nDo you see what I mean?"
    extend "\n\n\n\n你明白我的意思了吗？{size=-8}{color=#999999} \n\n\n\nDo you see what I mean?{/color}{/size}"

# game/ep2d6.rpy:31
translate chinese ep2d6_d41d8cd9_1:

    # nvl clear
    nvl clear

