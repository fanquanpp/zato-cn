    nvl clear

# game/ep2d6.rpy:10
translate chinese ep2d6_38319075:

    # n "Imagine drawing a line."
    n "想象你画下一条线。{size=-8}{color=#999999} Imagine drawing a line.{/color}{/size}"

# game/ep2d6.rpy:11
translate chinese ep2d6_db3444b7:

    # extend "\n\nIt doesn’t have to be perfectly straight – in all likelihood, it won’t be."
    extend "\n\n它不必笔直——多半也不会笔直。{size=-8}{color=#999999} \n\nIt doesn’t have to be perfectly straight – in all likelihood, it won’t be.{/color}{/size}"

# game/ep2d6.rpy:12
translate chinese ep2d6_02a00ba5:

    # extend " If you go on for long enough, it will get wavy, unstable or jagged."
    extend "画得够久，它就会起伏、摇摆或毛糙。{size=-8}{color=#999999} If you go on for long enough, it will get wavy, unstable or jagged.{/color}{/size}"

# game/ep2d6.rpy:13
translate chinese ep2d6_dd6e385d:

    # extend " After a certain point, even an artist’s steady hand can’t stay completely still."
    extend "过了某个点，就算是画家的稳手也无法保持完全静止。{size=-8}{color=#999999} After a certain point, even an artist’s steady hand can’t stay completely still.{/color}{/size}"

# game/ep2d6.rpy:14
translate chinese ep2d6_2fdb46e6:

    # extend "\n\nBut let’s say you keep going on and on in one direction."
    extend "\n\n但假设你朝一个方向一直画下去。{size=-8}{color=#999999} \n\nBut let’s say you keep going on and on in one direction.{/color}{/size}"

# game/ep2d6.rpy:15
translate chinese ep2d6_63a1935d:

    # extend "\n\nYou stare at the line you’ve drawn from up close and it looks like a mess."
    extend "\n\n凑近看你画出的线，它像一团乱麻。{size=-8}{color=#999999} \n\nYou stare at the line you’ve drawn from up close and it looks like a mess.{/color}{/size}"

# game/ep2d6.rpy:16
translate chinese ep2d6_929904ad:

    # extend " Wow!"
    extend " 哇！{size=-8}{color=#999999} Wow!{/color}{/size}"

# game/ep2d6.rpy:17
translate chinese ep2d6_e8a20a3b:

    # extend " So much variety, the rises, the falls, the soft waves, the sharp edges..."
    extend " 起伏、坠落、柔波、锐角……变化多丰富啊。{size=-8}{color=#999999} So much variety, the rises, the falls, the soft waves, the sharp edges...{/color}{/size}"

# game/ep2d6.rpy:18
translate chinese ep2d6_04235ce3:

    # extend " \n\n\n\n\nAnd then you zoom out."
    extend " \n\n\n\n\n然后你把镜头拉远。{size=-8}{color=#999999} \n\n\n\n\nAnd then you zoom out.{/color}{/size}"

# game/ep2d6.rpy:19
translate chinese ep2d6_2862b1ea:

    # nvl clear
    # n "The further you go, the more insignificant those little fluctuations become."
    nvl clear
    n "拉得越远，那些微小的波动就越微不足道。{size=-8}{color=#999999} The further you go, the more insignificant those little fluctuations become.{/color}{/size}"

# game/ep2d6.rpy:21
translate chinese ep2d6_474a0516:

    # extend " Once you rise way up high, your eyesight won’t distinguish them at all."
    extend " 升到足够高处，你的肉眼就再也分辨不出它们。{size=-8}{color=#999999} Once you rise way up high, your eyesight won’t distinguish them at all.{/color}{/size}"

# game/ep2d6.rpy:22
translate chinese ep2d6_9788ad64:

    # extend "\n\nAll you will see is a straight line."
    extend "\n\n你看到的，只剩一条直线。{size=-8}{color=#999999} \n\nAll you will see is a straight line.{/color}{/size}"

# game/ep2d6.rpy:23
translate chinese ep2d6_28bfe7ac:

    # extend "\n\n\n\nA single, perfect stroke."
    extend "\n\n\n\n一道完美的、笔直的笔画。{size=-8}{color=#999999} \n\n\n\nA single, perfect stroke.{/color}{/size}"

# game/ep2d6.rpy:24
translate chinese ep2d6_ecb4553b:

    # nvl clear
    # n "You might say, but what if the fluctuation is so massive, it encompasses most of that line?"
