# game/ep2d2.rpy:1929
translate chinese ep2d2_122c9bc1:

    # n "It’s not enough."
    n "这还不够。{size=-8}{color=#999999} It’s not enough.{/color}{/size}"

# game/ep2d2.rpy:1930
translate chinese ep2d2_dd06b32b:

    # extend "\n\nMy life is finite, and so is my gratitude."
    extend "\n\n我的人生是有限的，我的感激也是。{size=-8}{color=#999999} \n\nMy life is finite, and so is my gratitude.{/color}{/size}"

# game/ep2d2.rpy:1931
translate chinese ep2d2_8fc23a2f:

    # extend " It will never be enough, even if I keep living until our dying Sun swallows the Earth."
    extend "哪怕我活到垂死的太阳吞噬地球的那一天，也永远不够。{size=-8}{color=#999999} It will never be enough, even if I keep living until our dying Sun swallows the Earth.{/color}{/size}"

# game/ep2d2.rpy:1932
translate chinese ep2d2_516012be:

    # extend " It’s a promise I will never fulfil."
    extend "这是一个我永远无法兑现的承诺。{size=-8}{color=#999999} It’s a promise I will never fulfil.{/color}{/size}"

# game/ep2d2.rpy:1933
translate chinese ep2d2_aee47593:

    # extend "\n\n\n\n\n\nSo I’ll retract it."
    extend "\n\n\n\n\n\n所以我要撤回它。{size=-8}{color=#999999} \n\n\n\n\n\nSo I’ll retract it.{/color}{/size}"

# game/ep2d2.rpy:1934
translate chinese ep2d2_b769a1b3:

    # extend " I apologise."
    extend "我道歉。{size=-8}{color=#999999} I apologise.{/color}{/size}"

# game/ep2d2.rpy:1935
translate chinese ep2d2_d41d8cd9_8:

    # nvl clear
    nvl clear

# game/ep2d2.rpy:1939
translate chinese ep2d2_e6289957:

    # n "I need to try a different approach."
    n "我需要换一种方式。{size=-8}{color=#999999} I need to try a different approach.{/color}{/size}"

# game/ep2d2.rpy:1940
translate chinese ep2d2_86895eb6:

    # extend "\n\nThe number of gratitudes I can express will always be finite and meager."
    extend "\n\n我能说出的感谢永远是有限的、微薄的。{size=-8}{color=#999999} \n\nThe number of gratitudes I can express will always be finite and meager.{/color}{/size}"

# game/ep2d2.rpy:1941
translate chinese ep2d2_62113526:

    # extend " But what if the gratitude itself becomes infinite?"
    extend "可如果感激本身变成无限的呢？{size=-8}{color=#999999} But what if the gratitude itself becomes infinite?{/color}{/size}"

# game/ep2d2.rpy:1942
translate chinese ep2d2_074b9f7c:

    # extend "\n\n\n\n\n\nAn expression of endless gratitude..."
    extend "\n\n\n\n\n\n一种无尽的感激的表达……{size=-8}{color=#999999} \n\n\n\n\n\nAn expression of endless gratitude...{/color}{/size}"

# game/ep2d2.rpy:1943
translate chinese ep2d2_21985ba5:

    # extend "\n\nIs that possible?"
    extend "\n\n这可能吗？{size=-8}{color=#999999} \n\nIs that possible?{/color}{/size}"

# game/ep2d2.rpy:1944
translate chinese ep2d2_d68a6746:

    # extend " Does it sound right?"
    extend "听起来像话吗？{size=-8}{color=#999999} Does it sound right?{/color}{/size}"

# game/ep2d2.rpy:1945
translate chinese ep2d2_d961bfd6:

    # nvl clear
    # n "I can repeat my thanks for as long as I live, like a pulsar emitting wave after wave of electromagnetic radiation."
    nvl clear
    n "我可以在有生之年不断重复我的感谢，就像一颗脉冲星，一波接一波地释放电磁辐射。{size=-8}{color=#999999} I can repeat my thanks for as long as I live, like a pulsar emitting wave after wave of electromagnetic radiation.{/color}{/size}"

# game/ep2d2.rpy:1947
translate chinese ep2d2_ad6df13d:

    # extend " Yes, just like that."
    extend "对，就是这样。{size=-8}{color=#999999} Yes, just like that.{/color}{/size}"

# game/ep2d2.rpy:1948
translate chinese ep2d2_2a4f6a80:

    # extend " A pulsar's radiation travels endlessly inside a vacuum."
    extend "脉冲星的辐射在真空中永不停歇地传播。{size=-8}{color=#999999} A pulsar's radiation travels endlessly inside a vacuum.{/color}{/size}"

# game/ep2d2.rpy:1949
translate chinese ep2d2_eb9bc29e:

    # extend " Mine should be able to do the same."
    extend "我的信号也理应如此。{size=-8}{color=#999999} Mine should be able to do the same.{/color}{/size}"

# game/ep2d2.rpy:1950
translate chinese ep2d2_fb1fea9f:

    # extend "\n\nBut right now, my signals keep getting buried under the 10,000 kilometres of our planet’s atmosphere."
    extend "\n\n可眼下，我的信号总被埋在我们星球一万公里厚的大气层之下。{size=-8}{color=#999999} \n\nBut right now, my signals keep getting buried under the 10,000 kilometres of our planet’s atmosphere.{/color}{/size}"

# game/ep2d2.rpy:1951
translate chinese ep2d2_b1a186b3:

    # extend " They’re too weak, they dissipate under the weight of over 5 quadrillion tons of air."
    extend "它们太弱了，在五千万亿吨空气的重压下耗散殆尽。{size=-8}{color=#999999} They’re too weak, they dissipate under the weight of over 5 quadrillion tons of air.{/color}{/size}"

# game/ep2d2.rpy:1952
translate chinese ep2d2_f3f9f789:

    # extend "\n\nWell, not as much if they travel straight up..."
    extend "\n\n嘛，如果是垂直向上发射的话，损耗会小一些……{size=-8}{color=#999999} \n\nWell, not as much if they travel straight up...{/color}{/size}"

# game/ep2d2.rpy:1953
translate chinese ep2d2_404ffe99:

    # extend " But I’m not good enough at math to do the numbers."
    extend "但我数学不好，算不出具体数字。{size=-8}{color=#999999} But I’m not good enough at math to do the numbers.{/color}{/size}"

# game/ep2d2.rpy:1954
translate chinese ep2d2_9e804cd8:

    # extend "\n\n\n\nAll I that know is, my signal isn’t strong enough."
    extend "\n\n\n\n我只知道，我的信号还不够强。{size=-8}{color=#999999} \n\n\n\nAll I that know is, my signal isn’t strong enough.{/color}{/size}"

# game/ep2d2.rpy:1955
translate chinese ep2d2_0fe9ee8a:

    # nvl clear
    # n "So then, what can I do?"
    nvl clear
    n "那么，我还能做什么？{size=-8}{color=#999999} So then, what can I do?{/color}{/size}"

# game/ep2d2.rpy:1958
translate chinese ep2d2_49abff84:

    # extend "\n\nI could become an astronaut and fire off my messages from orbit."
    extend "\n\n我可以成为宇航员，从轨道上发送我的讯息。{size=-8}{color=#999999} \n\nI could become an astronaut and fire off my messages from orbit.{/color}{/size}"

# game/ep2d2.rpy:1959
translate chinese ep2d2_8031ae3a:

    # extend " That has to work..."
    extend "那样一定能行……{size=-8}{color=#999999} That has to work...{/color}{/size}"

# game/ep2d2.rpy:1960
translate chinese ep2d2_40ebb142:

    # extend "\n\nExcept I don’t have anything it takes to be an astronaut."
    extend "\n\n可惜，我完全不具备成为宇航员的任何条件。{size=-8}{color=#999999} \n\nExcept I don’t have anything it takes to be an astronaut.{/color}{/size}"

# game/ep2d2.rpy:1961
translate chinese ep2d2_58121fad:

    # extend "\n\nThe next best thing would be to send a strong radio signal from the surface."
    extend "\n\n退而求其次，是从地面发射一个强大的无线电信号。{size=-8}{color=#999999} \n\nThe next best thing would be to send a strong radio signal from the surface.{/color}{/size}"

# game/ep2d2.rpy:1962
translate chinese ep2d2_a10c0ad2:

    # extend " But sending a transmission powerful enough to break through the Earth’s atmosphere requires equipment that’s way out of my reach."
    extend "但发射足以穿透地球大气层的讯号，所需设备远非我能企及。{size=-8}{color=#999999} But sending a transmission powerful enough to break through the Earth’s atmosphere requires equipment that’s way out of my reach.{/color}{/size}"

# game/ep2d2.rpy:1963
translate chinese ep2d2_96a76f29:

    # extend "\n\nIt’s in the same realm of possibility as me actually travelling to space."
    extend "\n\n这和我真的飞上太空的可能性差不多。{size=-8}{color=#999999} \n\nIt’s in the same realm of possibility as me actually travelling to space.{/color}{/size}"

# game/ep2d2.rpy:1964
translate chinese ep2d2_4861217d:

    # nvl clear
    # n "But then, what other options are there?"
    nvl clear
    n "那么，还有别的选项吗？{size=-8}{color=#999999} But then, what other options are there?{/color}{/size}"

# game/ep2d2.rpy:1967
translate chinese ep2d2_e4f47994:

    # extend " How can my broadcast persevere...?"
    extend "我的播报怎样才能坚持下去……？{size=-8}{color=#999999} How can my broadcast persevere...?{/color}{/size}"

# game/ep2d2.rpy:1968
translate chinese ep2d2_7e1ca0c2:

    # extend "\n\n\n\n\n\n..."
    extend "\n\n\n\n\n\n……{size=-8}{color=#999999} \n\n\n\n\n\n...{/color}{/size}"

# game/ep2d2.rpy:1969
translate chinese ep2d2_e85b9739:

    # extend "Ah."
    extend "啊。{size=-8}{color=#999999} Ah.{/color}{/size}"

# game/ep2d2.rpy:1970
translate chinese ep2d2_9f1d1675:

    # extend " Right."
    extend "对哦。{size=-8}{color=#999999} Right.{/color}{/size}"

# game/ep2d2.rpy:1971
translate chinese ep2d2_8a6232cb:

